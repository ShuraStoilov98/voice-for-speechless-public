{
  "name": "voice-for-speechless",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "test:browser": "playwright test",
    "export:web": "expo export --platform web --output-dir dist/web",
    "preview": "node scripts/preview.mjs",
    "check:public": "node scripts/check-public.mjs"
  },
  "dependencies": {
    "expo": "~54.0.33",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.22",
    "expo-secure-store": "~15.0.8",
    "expo-speech": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^1.52.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/react": "~19.1.0",
    "sharp": "^0.35.5",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "postcss": "^8.5.29",
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
