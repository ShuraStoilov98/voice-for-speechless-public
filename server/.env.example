# Server-only values. Never put these in Expo config or a client bundle.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional: predictions return [] unless this key is configured.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Comma-separated SHA-256 hashes, one per installation. Run npm run credential.
INSTALLATION_TOKEN_HASHES=
# SQLite on a persistent local disk; mandatory in production.
USAGE_DB_PATH=.data/usage.sqlite
DAILY_REQUEST_LIMIT=300
DAILY_CHARACTER_LIMIT=20000
REQUESTS_PER_MINUTE=12
MAX_CONCURRENT_REQUESTS=2
PROVIDER_TIMEOUT_MS=15000
PORT=3001
HOST=127.0.0.1
# Exact browser origins only; native clients do not need CORS.
ALLOWED_ORIGINS=http://localhost:8081
